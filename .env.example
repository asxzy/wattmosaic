# WattMosaic configuration — copy to .env and fill in real values.
# NEVER commit .env.

# --- Home Assistant (read-only long-lived token required) -------------------
# HA_URL takes precedence over HA_HOST. Port defaults to 8123.
HA_HOST=192.168.1.10
# HA_URL=http://homeassistant.local:8123
HA_TOKEN=replace-with-a-long-lived-access-token

# --- Engine API -------------------------------------------------------------
WM_API_HOST=0.0.0.0
WM_API_PORT=8787
# Shared token the integration must send in X-API-Token (recommended on HA OS).
WM_API_TOKEN=replace-with-a-random-local-token

# --- Storage ----------------------------------------------------------------
WM_DATABASE_PATH=/data/wattmosaic.db
WM_RETENTION_DAYS_RAW=30
WM_RETENTION_DAYS_AGGREGATES=730

# --- Behaviour --------------------------------------------------------------
WM_LEARNING_ENABLED=true
WM_STALE_AFTER_S=120
WM_INFERENCE_INTERVAL_S=5
WM_LOG_LEVEL=INFO
WM_LOG_JSON=true
