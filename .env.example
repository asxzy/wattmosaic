# WattMosaic configuration — copy to .env and fill in real values.
# NEVER commit .env.

# --- Home Assistant (read-only long-lived token required) -------------------
# HA_URL takes precedence over HA_HOST. Port defaults to 8123.
HA_HOST=192.168.1.10
# HA_URL=http://homeassistant.local:8123
HA_TOKEN=replace-with-a-long-lived-access-token

# --- Engine API -------------------------------------------------------------
WM_API_HOST=0.0.0.0
WM_API_PORT=8787
# Shared token the integration must send in X-API-Token (recommended on HA OS).
WM_API_TOKEN=replace-with-a-random-local-token

# --- Storage ----------------------------------------------------------------
WM_DATABASE_PATH=/data/wattmosaic.db
WM_RETENTION_DAYS_RAW=30
WM_RETENTION_DAYS_AGGREGATES=730

# --- Behaviour --------------------------------------------------------------
WM_LEARNING_ENABLED=true
WM_STALE_AFTER_S=120
WM_INFERENCE_INTERVAL_S=5
# Emit one WARNING per manually declared `dedicated_device` CT (ADR-0029) and
# list them under health["deprecations"]. Diagnostics only: `false` silences the
# notice and changes no watt, source, tier or confidence. Nothing is converted.
WM_DEPRECATE_DEDICATED_DECLARATION=true
WM_LOG_LEVEL=INFO
WM_LOG_JSON=true

# --- Versioned audit & analysis pass (contract 1.6.0) ----------------------
# Master switch. When false, no isolation verdict, association, circuit,
# residual, hierarchy edge or InferenceRecord is written, and the existing
# inference output is unchanged.
WM_AUDIT_ENABLED=true
# Per-artifact switches. Each gates *writing that family only*: the algorithms
# still run, so disabling one cannot silently change a value another derives.
WM_AUDIT_ISOLATION_ENABLED=true
WM_AUDIT_ASSOCIATION_ENABLED=true
WM_AUDIT_CIRCUITS_ENABLED=true
WM_AUDIT_RESIDUAL_ENABLED=true
WM_AUDIT_HIERARCHY_ENABLED=true
WM_AUDIT_RECORDS_ENABLED=true
# How far back GET /api/v1/devices/{id} reads inference history (seconds).
WM_HISTORY_LOOKBACK_S=86400
# Seconds between an HA event and the start of its analysis window. Raise it
# when a CT publishes less often than the device's physical response.
WM_ANALYSIS_OFFSET_S=0
# Width of the "was anything else changing?" window (s), and of the window
# whose readings are attributed to the event. The second must be >= the first.
WM_ISOLATION_WINDOW_S=30
WM_ISOLATION_POWER_WINDOW_S=60
# Version stamped onto every audit artifact (isolation verdicts, associations,
# circuits, hierarchy edges, InferenceRecords). A replay is only comparable to
# records written under the same value, so bump it when an algorithm changes.
WM_AUDIT_ALGORITHM_VERSION=disagg@2.0
#
# Per-device isolation overrides (JSON). One fixed duration is not optimal for
# every appliance: a hot tub's compressor is quiet for a minute while a lamp's
# step is over in a second. Resolution is
#   per-device override > device-class default > the global values above.
# Keys are analysis_offset_s / isolation_window_s / power_window_s (seconds);
# any other key is reported by `--check-config` and ignored.
# WM_ISOLATION_BY_CLASS={"hot_tub": {"isolation_window_s": 90, "power_window_s": 120}, "light": {"isolation_window_s": 5}}
# WM_ISOLATION_BY_DEVICE={"dev_refoss_main_panel_hot_tub": {"analysis_offset_s": 15}}
# Class labels for a device, when they do not come from its stored
# DeviceConfiguration.device_type / behavior (which are used automatically).
# WM_ISOLATION_DEVICE_CLASSES={"dev_refoss_main_panel_hot_tub": ["hot_tub"]}
# Periodic reanalysis from stored raw history, run on the existing inference
# loop (no extra thread). 0 disables it.
WM_REANALYSIS_INTERVAL_S=3600
WM_REANALYSIS_LOOKBACK_S=21600
