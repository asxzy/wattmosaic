{
  "$defs": {
    "ConfidenceTier": {
      "description": "Ordered evidence grade for a device power value (ADR-0013).\n\nA *grade*, not a probability.  ``InferenceResult.confidence`` remains the\nfiner-grained engineering score; the tier answers \"what kind of evidence\nproduced this number?\" without requiring the reader to interpret decimals.",
      "enum": [
        "tier_0_unknown",
        "tier_1_modelled",
        "tier_2_inferred",
        "tier_3_measured",
        "tier_4_verified"
      ],
      "title": "ConfidenceTier",
      "type": "string"
    },
    "ConfidenceVector": {
      "additionalProperties": false,
      "description": "Independent confidence dimensions.\n\nDeliberately has **no** aggregate field, no ``__float__`` and no arithmetic:\na consumer that wants one number must say which dimension it means.  Merging\nthe six components into one weighted blend is the defect this model exists\nto stop repeating (see ``docs/assessment_gap_analysis.md`` G14).",
      "properties": {
        "power": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Power"
        },
        "ct_association": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ct Association"
        },
        "topology": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Topology"
        },
        "circuit_classification": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Circuit Classification"
        },
        "residual": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Residual"
        },
        "method": {
          "default": "unavailable",
          "title": "Method",
          "type": "string"
        }
      },
      "title": "ConfidenceVector",
      "type": "object"
    },
