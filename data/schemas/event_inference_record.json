{
  "$defs": {
    "Bounds": {
      "additionalProperties": false,
      "description": "A justified interval for an estimate.\n\n``lower_w`` and ``upper_w`` are nullable (HB \u00a718).  When both are present\nthe validator requires ``lower_w <= upper_w``.  A zero-width interval\n(a point) is only possible through the private :meth:`_point` constructor,\nwhich represents an IDENTIFIABLE or MEASURED result; the ``allow_point``\nflag is *not* a field and never appears in the model or its JSON schema.",
      "properties": {
        "lower_w": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lower W"
        },
        "upper_w": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Upper W"
        },
        "basis": {
          "anyOf": [
            {
              "enum": [
                "non_negativity",
                "group_sum",
                "reader_ceiling",
                "posterior",
                "declared_ceiling"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Basis"
        }
      },
      "title": "Bounds",
      "type": "object"
    },
    "CandidateHypothesis": {
      "additionalProperties": false,
      "description": "One hypothesis explaining an observed event (HB \u00a77, evidence A..H).",
      "properties": {
        "candidate_id": {
          "title": "Candidate Id",
          "type": "string"
        },
        "subject_kind": {
          "enum": [
            "device",
            "component",
            "group",
            "unknown_profile",
            "unknown_scope"
          ],
          "title": "Subject Kind",
          "type": "string"
        },
        "subject_id": {
          "title": "Subject Id",
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/CandidateSource"
          },
          "title": "Sources",
          "type": "array"
        },
        "transition": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Transition"
        },
        "evidence_terms": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Evidence Terms",
          "type": "object"
        },
        "filtered": {
          "default": false,
          "title": "Filtered",
          "type": "boolean"
        },
        "filter_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Filter Reason"
        }
      },
      "required": [
        "candidate_id",
        "subject_kind",
        "subject_id",
        "sources",
        "evidence_terms"
      ],
      "title": "CandidateHypothesis",
      "type": "object"
    },
    "CandidateSource": {
      "description": "Where a candidate hypothesis came from (HB \u00a77.1, ten sources).",
      "enum": [
        "ha_state",
        "ha_attribute",
        "learned_profile",
        "prior_mapping",
        "plug",
        "unknown_profile",
        "topology_visible",
        "delayed_response",
        "device_group",
        "unknown_scope"
      ],
      "title": "CandidateSource",
      "type": "string"
    },
    "ConfidenceVectorV3": {
      "additionalProperties": false,
      "description": "Seven-component confidence vector for a v3 estimate.\n\nEach component is an *uncalibrated engineering score* in ``[0, 1]`` or\n``None`` when not assessed.  **This is not a probability** (ADR-0007): the\nnumbers are not calibrated, do not sum to one, and must not be interpreted\nas likelihoods.  There is deliberately **no blended scalar** field, no\n``__float__`` and no arithmetic -- a consumer must name the component it\nmeans (DEC-24; HB \u00a79.6).  This v3 type supersedes the legacy six-dimension\n``ConfidenceVector`` and is intentionally a distinct public name.",
      "properties": {
        "measurement_quality": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Measurement Quality"
        },
        "event_association": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Event Association"
        },
        "model_fit": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Fit"
        },
        "topology_consistency": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Topology Consistency"
        },
        "identifiability": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Identifiability"
        },
        "sample_coverage": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sample Coverage"
        },
        "freshness": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Freshness"
        }
      },
      "title": "ConfidenceVectorV3",
      "type": "object"
    },
    "DeviceEstimate": {
      "additionalProperties": false,
      "description": "A first-class estimate of one device or load component.\n\nA non-identifiable member has ``point_w is None`` and justified bounds,\nnever a fabricated number (DEC-19, HB \u00a78.4).",
      "properties": {
        "subject_kind": {
          "enum": [
            "device",
            "component"
          ],
          "title": "Subject Kind",
          "type": "string"
        },
        "subject_id": {
          "title": "Subject Id",
          "type": "string"
        },
        "point_w": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Point W"
        },
        "bounds": {
          "$ref": "#/$defs/Bounds"
        },
        "status": {
          "$ref": "#/$defs/EstimateStatus"
        },
        "identifiability": {
          "$ref": "#/$defs/IdentifiabilityStatus"
        },
        "group_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Group Id"
        },
        "level": {
          "anyOf": [
            {
              "$ref": "#/$defs/PowerLevel"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "method": {
          "$ref": "#/$defs/InferenceMethod"
        },
        "allocation_rule": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Allocation Rule"
        },
        "confidence": {
          "$ref": "#/$defs/ConfidenceVectorV3"
        },
        "source_reader_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Reader Ids",
          "type": "array"
        },
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "versions": {
          "$ref": "#/$defs/VersionTriple"
        },
        "model_version_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Version Id"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        },
        "provisional": {
          "default": false,
          "title": "Provisional",
          "type": "boolean"
        }
      },
      "required": [
        "subject_kind",
        "subject_id",
        "bounds",
        "status",
        "identifiability",
        "method",
        "confidence",
        "source_reader_ids",
        "evidence_refs",
        "versions",
        "updated_at"
      ],
      "title": "DeviceEstimate",
      "type": "object"
    },
    "DeviceGroupEstimate": {
      "additionalProperties": false,
      "description": "The identified sum of a non-separable device group (HB \u00a78.4).",
      "properties": {
        "group_id": {
          "title": "Group Id",
          "type": "string"
        },
        "member_ids": {
          "items": {
            "type": "string"
          },
          "title": "Member Ids",
          "type": "array"
        },
        "point_w": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Point W"
        },
        "bounds": {
          "$ref": "#/$defs/Bounds"
        },
        "identifiability": {
          "$ref": "#/$defs/IdentifiabilityStatus"
        },
        "source_reader_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Reader Ids",
          "type": "array"
        },
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "versions": {
          "$ref": "#/$defs/VersionTriple"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "group_id",
        "member_ids",
        "bounds",
        "identifiability",
        "source_reader_ids",
        "evidence_refs",
        "versions",
        "updated_at"
      ],
      "title": "DeviceGroupEstimate",
      "type": "object"
    },
    "EstimateStatus": {
      "description": "What kind of value an estimate is (HB \u00a78.5).",
      "enum": [
        "measured",
        "estimated",
        "allocated",
        "unknown"
      ],
      "title": "EstimateStatus",
      "type": "string"
    },
    "EventGroupStatusV3": {
      "description": "Lifecycle of an event group (HB \u00a712.3).\n\n``interfaces.md`` \u00a73 calls this enum ``EventGroupStatus``; that name belongs\nto K02's ``measurement`` module.  The suffix makes the two independent wave-1\nowners collision-free; the values are identical to \u00a73's six states.",
      "enum": [
        "detected",
        "matching",
        "provisional",
        "confirmed",
        "revised",
        "unresolved"
      ],
      "title": "EventGroupStatusV3",
      "type": "string"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "description": "A typed, resolvable reference to a piece of evidence (D4's resolver).",
      "properties": {
        "kind": {
          "enum": [
            "sample",
            "event_evidence",
            "event_group",
            "ha_event",
            "edge",
            "mapping_edge",
            "model_version",
            "configuration_event",
            "observation"
          ],
          "title": "Kind",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "IdentifiabilityStatus": {
      "description": "Identifiability of an estimate (HB \u00a78.4).",
      "enum": [
        "identifiable",
        "partially_identifiable",
        "group_identifiable",
        "non_identifiable",
        "insufficient_evidence"
      ],
      "title": "IdentifiabilityStatus",
      "type": "string"
    },
    "InferenceMethod": {
      "description": "How an estimate was obtained.",
      "enum": [
        "direct_reading",
        "joint_delta",
        "joint_absolute",
        "model_prior",
        "declared",
        "none"
      ],
      "title": "InferenceMethod",
      "type": "string"
    },
    "JointInferenceResult": {
      "additionalProperties": false,
      "description": "The typed handoff I7 -> M2/L4/D4/P6 (\u00a76).\n\n``result_id`` is a content hash of (group id, revision, versions, sorted\nestimates); it is independent of estimate list order so a replay is\nbyte-identical (AT-19).",
      "properties": {
        "result_id": {
          "title": "Result Id",
          "type": "string"
        },
        "event_group_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Event Group Id"
        },
        "event_group_revision": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Event Group Revision"
        },
        "status": {
          "$ref": "#/$defs/EventGroupStatusV3"
        },
        "device_estimates": {
          "items": {
            "$ref": "#/$defs/DeviceEstimate"
          },
          "title": "Device Estimates",
          "type": "array"
        },
        "group_estimates": {
          "items": {
            "$ref": "#/$defs/DeviceGroupEstimate"
          },
          "title": "Group Estimates",
          "type": "array"
        },
        "unknown_estimates": {
          "items": {
            "$ref": "#/$defs/UnknownEstimate"
          },
          "title": "Unknown Estimates",
          "type": "array"
        },
        "candidates": {
          "items": {
            "$ref": "#/$defs/CandidateHypothesis"
          },
          "title": "Candidates",
          "type": "array"
        },
        "matches": {
          "additionalProperties": {
            "$ref": "#/$defs/MatchState"
          },
          "title": "Matches",
          "type": "object"
        },
        "residual_w_by_reader": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Residual W By Reader",
          "type": "object"
        },
        "versions": {
          "$ref": "#/$defs/VersionTriple"
        },
        "computed_at": {
          "format": "date-time",
          "title": "Computed At",
          "type": "string"
        }
      },
      "required": [
        "result_id",
        "status",
        "device_estimates",
        "group_estimates",
        "unknown_estimates",
        "candidates",
        "matches",
        "residual_w_by_reader",
        "versions",
        "computed_at"
      ],
      "title": "JointInferenceResult",
      "type": "object"
    },
    "MatchState": {
      "description": "State of a candidate-to-subject match (HB \u00a77.6).",
      "enum": [
        "unmatched",
        "proposed",
        "provisional",
        "confirmed",
        "ambiguous",
        "conflicted",
        "rejected",
        "expired"
      ],
      "title": "MatchState",
      "type": "string"
    },
    "PowerLevel": {
      "description": "Which of a device's four power levels a published value belongs to.\n\n``06-device-and-load-model-spec.md`` \u00a75.1 names four levels -- standby,\nidle, active, transient -- and ``ExpectedPower`` carries the envelope\n(``standby_w``, ``idle_w``, ``on_w``, ``startup_w`` / ``shutdown_w``).\nThis enum is the label a *published* value carries.\n\nIt is a **different axis** from ``PowerState`` and must never be conflated\nwith it.  ``PowerState`` is a *provenance* label (``measured`` /\n``estimated`` / ``allocated`` / ``unknown``) derived by ``power_state_for``\nfrom ``Source`` and ``MeasurementBasis``; ``PowerLevel`` is the *operating\nlevel* the number sits at.  A value can be both ``measured`` and\n``standby``: the two fields answer different questions and coexist on\n``InferenceResult``.\n\n``UNKNOWN`` is the neutral default, so a payload that does not name a level\nreads as \"not stated\" rather than as a claim.",
      "enum": [
        "standby",
        "idle",
        "active",
        "transient",
        "unknown"
      ],
      "title": "PowerLevel",
      "type": "string"
    },
    "UnknownEstimate": {
      "additionalProperties": false,
      "description": "An unmonitored/unknown-scope competitor on a branch row (HB \u00a78).",
      "properties": {
        "scope_reader_id": {
          "title": "Scope Reader Id",
          "type": "string"
        },
        "delta_w": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Delta W"
        },
        "point_w": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Point W"
        },
        "sigma_w": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sigma W"
        },
        "profile_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Profile Id"
        }
      },
      "required": [
        "scope_reader_id"
      ],
      "title": "UnknownEstimate",
      "type": "object"
    },
    "VersionTriple": {
      "additionalProperties": false,
      "description": "The independent topology/mapping/model version triple (rule 20).",
      "properties": {
        "topology_version_id": {
          "title": "Topology Version Id",
          "type": "string"
        },
        "mapping_version_id": {
          "title": "Mapping Version Id",
          "type": "string"
        },
        "model_set_id": {
          "title": "Model Set Id",
          "type": "string"
        }
      },
      "required": [
        "topology_version_id",
        "mapping_version_id",
        "model_set_id"
      ],
      "title": "VersionTriple",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A versioned event interpretation; evidence immutable, result versioned.\n\n``interpretation_revision == 1`` iff ``previous_record_id is None`` \u2014 the\nsame chain rule :class:`legacy.InferenceRecord` applies to its revision.",
  "properties": {
    "record_id": {
      "title": "Record Id",
      "type": "string"
    },
    "event_group_id": {
      "title": "Event Group Id",
      "type": "string"
    },
    "interpretation_revision": {
      "minimum": 1,
      "title": "Interpretation Revision",
      "type": "integer"
    },
    "previous_record_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Previous Record Id"
    },
    "result": {
      "$ref": "#/$defs/JointInferenceResult"
    },
    "reason": {
      "enum": [
        "initial",
        "late_data",
        "window_closed",
        "model_update",
        "topology_update",
        "replay"
      ],
      "title": "Reason",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "record_id",
    "event_group_id",
    "interpretation_revision",
    "result",
    "reason",
    "created_at"
  ],
  "title": "EventInferenceRecord",
  "type": "object",
  "$id": "https://wattmosaic.local/schemas/event_inference_record.json",
  "x-contract-version": "2.4.0"
}
