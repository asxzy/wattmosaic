{
  "$defs": {
    "Bounds": {
      "additionalProperties": false,
      "description": "A justified interval for an estimate.\n\n``lower_w`` and ``upper_w`` are nullable (HB \u00a718).  When both are present\nthe validator requires ``lower_w <= upper_w``.  A zero-width interval\n(a point) is only possible through the private :meth:`_point` constructor,\nwhich represents an IDENTIFIABLE or MEASURED result; the ``allow_point``\nflag is *not* a field and never appears in the model or its JSON schema.",
      "properties": {
        "lower_w": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lower W"
        },
        "upper_w": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Upper W"
        },
        "basis": {
          "anyOf": [
            {
              "enum": [
                "non_negativity",
                "group_sum",
                "reader_ceiling",
                "posterior",
                "declared_ceiling"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Basis"
        }
      },
      "title": "Bounds",
      "type": "object"
    },
    "EstimateStatus": {
      "description": "What kind of value an estimate is (HB \u00a78.5).",
      "enum": [
        "measured",
        "estimated",
        "allocated",
        "unknown"
      ],
      "title": "EstimateStatus",
      "type": "string"
    },
    "PowerLevelV3": {
      "description": "Operating level of a published value (HB \u00a711.5).\n\n``OFF`` and ``STANDBY`` are distinct members: OFF is a transition endpoint, not a claim of 0 W (HB \u00a711.5,\nrule 6).  ``UNKNOWN`` is the neutral default.",
      "enum": [
        "off",
        "standby",
        "idle",
        "active",
        "transient",
        "unknown"
      ],
      "title": "PowerLevelV3",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "The power block of a cell: contribution, bounds and operating state.\n\n``estimated_power_w`` is ``None`` when the mapping is not observable or the\ncell is group-only; it is never defaulted to ``0`` (HB \u00a718).",
  "properties": {
    "measurement_status": {
      "$ref": "#/$defs/EstimateStatus"
    },
    "estimated_power_w": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Estimated Power W"
    },
    "bounds": {
      "anyOf": [
        {
          "$ref": "#/$defs/Bounds"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "standby_power_w": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Standby Power W"
    },
    "operating_state": {
      "anyOf": [
        {
          "$ref": "#/$defs/PowerLevelV3"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "expected_profile_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expected Profile Ref"
    },
    "uncertainty_w": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Uncertainty W"
    }
  },
  "required": [
    "measurement_status"
  ],
  "title": "CellPower",
  "type": "object",
  "$id": "https://wattmosaic.local/schemas/cell_power.json",
  "x-contract-version": "4.0.0"
}
