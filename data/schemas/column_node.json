{
  "$defs": {
    "ColumnAnnotation": {
      "additionalProperties": false,
      "description": "A secondary edge on a reader leaf \u2014 never an extra column (design \u00a78).",
      "properties": {
        "kind": {
          "enum": [
            "SHARED_LOAD",
            "PAIRED_LEG",
            "SAME_CONDUCTOR",
            "CORRELATED",
            "CONTAINS",
            "ALIAS"
          ],
          "title": "Kind",
          "type": "string"
        },
        "related_reader_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Related Reader Id"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "kind"
      ],
      "title": "ColumnAnnotation",
      "type": "object"
    },
    "ColumnNode": {
      "additionalProperties": false,
      "description": "One node of the L0\u2013L4 column tree.\n\nA ``reader`` node is a leaf: it has ``reader_id`` set and no children.  Any\nother kind is an internal node with no ``reader_id``.  Secondary relations\nlive in ``annotations`` so they never duplicate a reader leaf.",
      "properties": {
        "node_id": {
          "title": "Node Id",
          "type": "string"
        },
        "level": {
          "enum": [
            "L0",
            "L1",
            "L2",
            "L3",
            "L4"
          ],
          "title": "Level",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "kind": {
          "enum": [
            "domain",
            "panel",
            "subpanel",
            "circuit",
            "reader",
            "unassigned"
          ],
          "title": "Kind",
          "type": "string"
        },
        "reader_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reader Id"
        },
        "children": {
          "items": {
            "$ref": "#/$defs/ColumnNode"
          },
          "title": "Children",
          "type": "array"
        },
        "annotations": {
          "items": {
            "$ref": "#/$defs/ColumnAnnotation"
          },
          "title": "Annotations",
          "type": "array"
        }
      },
      "required": [
        "node_id",
        "level",
        "label",
        "kind"
      ],
      "title": "ColumnNode",
      "type": "object"
    }
  },
  "$ref": "#/$defs/ColumnNode",
  "$id": "https://wattmosaic.local/schemas/column_node.json",
  "x-contract-version": "3.0.0"
}
