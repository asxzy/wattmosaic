{
  "$defs": {
    "StepClass": {
      "description": "Character of a detected reader change (P3).",
      "enum": [
        "sustained",
        "transient",
        "periodic",
        "drift",
        "data_gap"
      ],
      "title": "StepClass",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "One detected reader change (P3), with a stable, identity-based id.\n\nA ``DATA_GAP`` carries *no* measurement: ``delta_w``, ``sigma_w`` and\n``z_score`` are ``None``, never a ``0.0`` sentinel (HB \u00a718).  Every other\nstep class must carry all three numbers.  The invariant is enforced by\n:meth:`_null_measurements_match_step_class`.",
  "properties": {
    "event_id": {
      "title": "Event Id",
      "type": "string"
    },
    "reader_id": {
      "title": "Reader Id",
      "type": "string"
    },
    "delta_w": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Delta W"
    },
    "sigma_w": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sigma W"
    },
    "z_score": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Z Score"
    },
    "step_class": {
      "$ref": "#/$defs/StepClass"
    },
    "onset_lo": {
      "format": "date-time",
      "title": "Onset Lo",
      "type": "string"
    },
    "onset_hi": {
      "format": "date-time",
      "title": "Onset Hi",
      "type": "string"
    },
    "pre_level_w": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pre Level W"
    },
    "post_level_w": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Post Level W"
    },
    "quality_score": {
      "title": "Quality Score",
      "type": "number"
    },
    "detected_at": {
      "format": "date-time",
      "title": "Detected At",
      "type": "string"
    }
  },
  "required": [
    "event_id",
    "reader_id",
    "step_class",
    "onset_lo",
    "onset_hi",
    "quality_score",
    "detected_at"
  ],
  "title": "MeasurementEvent",
  "type": "object",
  "$id": "https://wattmosaic.local/schemas/measurement_event.json",
  "x-contract-version": "2.4.0"
}
