{
  "$defs": {
    "MeasurementBasis": {
      "description": "What produced the watt value, independent of how much we trust it.\n\n``Source`` answers *\"how was the value obtained\"*; this answers *\"what kind\nof instrument produced the watts\"*.  A ``DIRECT_MEASURED`` result can be\n``FACTOR_ADJUSTED``, and a ``MODEL_ESTIMATED`` result can never be\n``CT_MEASURED``.",
      "enum": [
        "ct_measured",
        "monitor_reported",
        "factor_adjusted",
        "estimated_appliance_total",
        "unknown"
      ],
      "title": "MeasurementBasis",
      "type": "string"
    },
    "QualityStatus": {
      "enum": [
        "good",
        "degraded",
        "stale",
        "bad",
        "missing"
      ],
      "title": "QualityStatus",
      "type": "string"
    },
    "ResidualKind": {
      "description": "The sign of a residual, derived from the value and never supplied.",
      "enum": [
        "positive",
        "negative",
        "near_zero"
      ],
      "title": "ResidualKind",
      "type": "string"
    },
    "ResidualPower": {
      "additionalProperties": false,
      "description": "Residual power as a first-class value: signed, never clamped, may stay\nunresolved forever.",
      "properties": {
        "residual_w": {
          "default": 0.0,
          "title": "Residual W",
          "type": "number"
        },
        "kind": {
          "$ref": "#/$defs/ResidualKind",
          "default": "near_zero"
        },
        "resolved": {
          "default": false,
          "title": "Resolved",
          "type": "boolean"
        },
        "unresolved_since": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unresolved Since"
        },
        "explained_by_device_w": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Explained By Device W",
          "type": "object"
        },
        "quality_status": {
          "$ref": "#/$defs/QualityStatus",
          "default": "good"
        },
        "basis": {
          "$ref": "#/$defs/MeasurementBasis",
          "default": "unknown"
        },
        "baseline_w": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Baseline W"
        },
        "dynamic_w": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dynamic W"
        }
      },
      "title": "ResidualPower",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Home-level power balance.  Residual is never redistributed.",
  "properties": {
    "timestamp": {
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    },
    "topology_version": {
      "default": 1,
      "title": "Topology Version",
      "type": "integer"
    },
    "main_power_w": {
      "default": 0.0,
      "title": "Main Power W",
      "type": "number"
    },
    "l1_power_w": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "L1 Power W"
    },
    "l2_power_w": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "L2 Power W"
    },
    "direct_measured_w": {
      "default": 0.0,
      "title": "Direct Measured W",
      "type": "number"
    },
    "inferred_w": {
      "default": 0.0,
      "title": "Inferred W",
      "type": "number"
    },
    "model_estimated_w": {
      "default": 0.0,
      "title": "Model Estimated W",
      "type": "number"
    },
    "configured_prior_w": {
      "default": 0.0,
      "title": "Configured Prior W",
      "type": "number"
    },
    "unknown_residual_w": {
      "default": 0.0,
      "title": "Unknown Residual W",
      "type": "number"
    },
    "unmonitored_w": {
      "default": 0.0,
      "title": "Unmonitored W",
      "type": "number"
    },
    "meter_disagreement_w": {
      "default": 0.0,
      "title": "Meter Disagreement W",
      "type": "number"
    },
    "meter_spread_w": {
      "default": 0.0,
      "title": "Meter Spread W",
      "type": "number"
    },
    "meter_spread_exceeds_residual": {
      "default": false,
      "title": "Meter Spread Exceeds Residual",
      "type": "boolean"
    },
    "reconciliation_error_w": {
      "default": 0.0,
      "title": "Reconciliation Error W",
      "type": "number"
    },
    "reconciliation_error_ratio": {
      "default": 0.0,
      "title": "Reconciliation Error Ratio",
      "type": "number"
    },
    "accounted_fraction": {
      "default": 0.0,
      "title": "Accounted Fraction",
      "type": "number"
    },
    "measurement_uncertainty_w": {
      "default": 0.0,
      "title": "Measurement Uncertainty W",
      "type": "number"
    },
    "quality_status": {
      "$ref": "#/$defs/QualityStatus",
      "default": "good"
    },
    "explanation": {
      "items": {
        "type": "string"
      },
      "title": "Explanation",
      "type": "array"
    },
    "topology_confirmed": {
      "default": false,
      "title": "Topology Confirmed",
      "type": "boolean"
    },
    "residual": {
      "anyOf": [
        {
          "$ref": "#/$defs/ResidualPower"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "title": "Reconciliation",
  "type": "object",
  "$id": "https://wattmosaic.local/schemas/reconciliation.json",
  "x-contract-version": "1.6.0"
}
