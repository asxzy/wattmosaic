{
  "$defs": {
    "MeasurementBasis": {
      "description": "What produced the watt value, independent of how much we trust it.\n\n``Source`` answers *\"how was the value obtained\"*; this answers *\"what kind\nof instrument produced the watts\"*.  A ``DIRECT_MEASURED`` result can be\n``FACTOR_ADJUSTED``, and a ``MODEL_ESTIMATED`` result can never be\n``CT_MEASURED``.",
      "enum": [
        "ct_measured",
        "monitor_reported",
        "factor_adjusted",
        "estimated_appliance_total",
        "unknown"
      ],
      "title": "MeasurementBasis",
      "type": "string"
    },
    "QualityStatus": {
      "enum": [
        "good",
        "degraded",
        "stale",
        "bad",
        "missing"
      ],
      "title": "QualityStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "A slow, persistent movement of a reader's residual baseline.\n\nA drift is recorded as a new, versioned observation: the previously stored\nresidual points are never rewritten and a published baseline is never\nmutated in place.",
  "properties": {
    "change_id": {
      "title": "Change Id",
      "type": "string"
    },
    "scope_id": {
      "title": "Scope Id",
      "type": "string"
    },
    "reader_id": {
      "title": "Reader Id",
      "type": "string"
    },
    "previous_baseline_w": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Previous Baseline W"
    },
    "new_baseline_w": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "New Baseline W"
    },
    "delta_w": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Delta W"
    },
    "direction": {
      "title": "Direction",
      "type": "string"
    },
    "window_count": {
      "default": 0,
      "title": "Window Count",
      "type": "integer"
    },
    "window_samples": {
      "default": 0,
      "title": "Window Samples",
      "type": "integer"
    },
    "window_start": {
      "format": "date-time",
      "title": "Window Start",
      "type": "string"
    },
    "window_end": {
      "format": "date-time",
      "title": "Window End",
      "type": "string"
    },
    "noise_floor_w": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Noise Floor W"
    },
    "estimator": {
      "default": "no_window_current_only",
      "title": "Estimator",
      "type": "string"
    },
    "basis": {
      "$ref": "#/$defs/MeasurementBasis",
      "default": "unknown"
    },
    "quality": {
      "$ref": "#/$defs/QualityStatus",
      "default": "good"
    },
    "contract_version": {
      "default": "2.1.0",
      "title": "Contract Version",
      "type": "string"
    },
    "topology_version": {
      "default": "",
      "title": "Topology Version",
      "type": "string"
    },
    "algorithm_version": {
      "default": "",
      "title": "Algorithm Version",
      "type": "string"
    },
    "recorded_at": {
      "format": "date-time",
      "title": "Recorded At",
      "type": "string"
    }
  },
  "required": [
    "change_id",
    "scope_id",
    "reader_id",
    "direction",
    "window_start",
    "window_end"
  ],
  "title": "ResidualBaselineChange",
  "type": "object",
  "$id": "https://wattmosaic.local/schemas/residual_baseline_change.json",
  "x-contract-version": "2.1.0"
}
