{
  "$defs": {
    "MeasurementBasis": {
      "description": "What produced the watt value, independent of how much we trust it.\n\n``Source`` answers *\"how was the value obtained\"*; this answers *\"what kind\nof instrument produced the watts\"*.  A ``DIRECT_MEASURED`` result can be\n``FACTOR_ADJUSTED``, and a ``MODEL_ESTIMATED`` result can never be\n``CT_MEASURED``.",
      "enum": [
        "ct_measured",
        "monitor_reported",
        "factor_adjusted",
        "estimated_appliance_total",
        "unknown"
      ],
      "title": "MeasurementBasis",
      "type": "string"
    },
    "QualityStatus": {
      "enum": [
        "good",
        "degraded",
        "stale",
        "bad",
        "missing"
      ],
      "title": "QualityStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "A sustained, sigma-relative departure of a reader's residual.\n\nThe evidence record of an unknown residual event.  The record is\n*complete*: a reader can recompute the threshold, the duration and the\ndecision from it without re-reading the raw samples.",
  "properties": {
    "event_id": {
      "title": "Event Id",
      "type": "string"
    },
    "scope_id": {
      "title": "Scope Id",
      "type": "string"
    },
    "reader_id": {
      "title": "Reader Id",
      "type": "string"
    },
    "window_start": {
      "format": "date-time",
      "title": "Window Start",
      "type": "string"
    },
    "window_end": {
      "format": "date-time",
      "title": "Window End",
      "type": "string"
    },
    "window": {
      "items": {
        "type": "number"
      },
      "title": "Window",
      "type": "array"
    },
    "baseline_w": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Baseline W"
    },
    "dynamic_w": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Dynamic W"
    },
    "residual_w": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Residual W"
    },
    "noise_floor_w": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Noise Floor W"
    },
    "noise_source": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Noise Source"
    },
    "threshold_w": {
      "title": "Threshold W",
      "type": "number"
    },
    "k": {
      "default": 3.0,
      "title": "K",
      "type": "number"
    },
    "min_duration_s": {
      "title": "Min Duration S",
      "type": "number"
    },
    "observed_cadence_s": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Observed Cadence S"
    },
    "estimator": {
      "default": "no_window_current_only",
      "title": "Estimator",
      "type": "string"
    },
    "basis": {
      "$ref": "#/$defs/MeasurementBasis",
      "default": "unknown"
    },
    "quality": {
      "$ref": "#/$defs/QualityStatus",
      "default": "good"
    },
    "contract_version": {
      "default": "3.0.0",
      "title": "Contract Version",
      "type": "string"
    },
    "topology_version": {
      "default": "",
      "title": "Topology Version",
      "type": "string"
    },
    "algorithm_version": {
      "default": "",
      "title": "Algorithm Version",
      "type": "string"
    },
    "recorded_at": {
      "format": "date-time",
      "title": "Recorded At",
      "type": "string"
    }
  },
  "required": [
    "event_id",
    "scope_id",
    "reader_id",
    "window_start",
    "window_end",
    "threshold_w",
    "min_duration_s"
  ],
  "title": "UnknownResidualEvent",
  "type": "object",
  "$id": "https://wattmosaic.local/schemas/unknown_residual_event.json",
  "x-contract-version": "3.0.0"
}
