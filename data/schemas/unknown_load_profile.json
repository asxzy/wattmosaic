{
  "$defs": {
    "ConfidenceVector": {
      "additionalProperties": false,
      "description": "Independent confidence dimensions.\n\nDeliberately has **no** aggregate field, no ``__float__`` and no arithmetic:\na consumer that wants one number must say which dimension it means.  Merging\nthe six components into one weighted blend is the defect this model exists\nto stop repeating (see ``docs/assessment_gap_analysis.md`` G14).",
      "properties": {
        "power": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Power"
        },
        "ct_association": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ct Association"
        },
        "topology": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Topology"
        },
        "circuit_classification": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Circuit Classification"
        },
        "residual": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Residual"
        },
        "method": {
          "default": "unavailable",
          "title": "Method",
          "type": "string"
        }
      },
      "title": "ConfidenceVector",
      "type": "object"
    },
    "MeasurementBasis": {
      "description": "What produced the watt value, independent of how much we trust it.\n\n``Source`` answers *\"how was the value obtained\"*; this answers *\"what kind\nof instrument produced the watts\"*.  A ``DIRECT_MEASURED`` result can be\n``FACTOR_ADJUSTED``, and a ``MODEL_ESTIMATED`` result can never be\n``CT_MEASURED``.",
      "enum": [
        "ct_measured",
        "monitor_reported",
        "factor_adjusted",
        "estimated_appliance_total",
        "unknown"
      ],
      "title": "MeasurementBasis",
      "type": "string"
    },
    "UnknownLoadLifecycle": {
      "description": "The lifecycle of an unknown-load profile (spec 09 \u00a77.4).\n\nThe **only** lifecycle vocabulary for an unknown load across the\nspecification set (05 \u00a710.3).  There is deliberately no ``CONFIRMED``\nstate: the system may *propose* a name for an unknown load, and a proposal\nis never auto-confirmed.",
      "enum": [
        "observing",
        "characterised",
        "candidate",
        "retired"
      ],
      "title": "UnknownLoadLifecycle",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "A recurring, un-attributed load signature with an explicit lifecycle.\n\nA *projection* over the residual evidence, never a replacement for it: the\nresidual stays the authoritative total and a profile is never presented as\nan identified device.  A retired profile is retained, never deleted.",
  "properties": {
    "profile_id": {
      "title": "Profile Id",
      "type": "string"
    },
    "label": {
      "default": "",
      "title": "Label",
      "type": "string"
    },
    "lifecycle": {
      "$ref": "#/$defs/UnknownLoadLifecycle",
      "default": "observing"
    },
    "signature": {
      "items": {
        "type": "number"
      },
      "title": "Signature",
      "type": "array"
    },
    "scope_id": {
      "title": "Scope Id",
      "type": "string"
    },
    "reader_id": {
      "title": "Reader Id",
      "type": "string"
    },
    "first_seen_at": {
      "format": "date-time",
      "title": "First Seen At",
      "type": "string"
    },
    "last_seen_at": {
      "format": "date-time",
      "title": "Last Seen At",
      "type": "string"
    },
    "event_count": {
      "default": 0,
      "title": "Event Count",
      "type": "integer"
    },
    "mean_power_w": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Mean Power W"
    },
    "peak_power_w": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Peak Power W"
    },
    "median_duration_s": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Median Duration S"
    },
    "retirement_horizon_s": {
      "default": 2592000.0,
      "title": "Retirement Horizon S",
      "type": "number"
    },
    "promoted_device_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Promoted Device Id"
    },
    "requires_confirmation": {
      "default": true,
      "title": "Requires Confirmation",
      "type": "boolean"
    },
    "confidence": {
      "$ref": "#/$defs/ConfidenceVector"
    },
    "basis": {
      "$ref": "#/$defs/MeasurementBasis",
      "default": "unknown"
    },
    "evidence_event_ids": {
      "items": {
        "type": "string"
      },
      "title": "Evidence Event Ids",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "version": {
      "default": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "profile_id",
    "scope_id",
    "reader_id",
    "first_seen_at",
    "last_seen_at"
  ],
  "title": "UnknownLoadProfile",
  "type": "object",
  "$id": "https://wattmosaic.local/schemas/unknown_load_profile.json",
  "x-contract-version": "2.1.0"
}
