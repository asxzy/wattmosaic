{
  "$defs": {
    "LoadShape": {
      "description": "How a device draws power -- a declared property of the appliance.\n\nThe v3 model class (:class:`~wattmosaic_engine.contracts.ModelClass`) is\nchosen from it (DEC-34).  Rule: a load shape is **declared**, never\ninferred: no code path derives it from a device name, an entity id or any\nother naming surface.  ``UNKNOWN`` is the neutral default.",
      "enum": [
        "fixed",
        "adjustable",
        "dynamic",
        "delayed",
        "always_on",
        "unknown"
      ],
      "title": "LoadShape",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "A real-world appliance or load (HB \u00a71.1 A).\n\n``device_id`` is opaque and preserved verbatim for legacy devices; new ids\nfollow ``pd_<ulid>`` (DEC-04).  HA connectivity is optional: some devices\nhave no HA entity at all (HB \u00a71.2).",
  "properties": {
    "device_id": {
      "title": "Device Id",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "device_type": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Device Type"
    },
    "load_shape": {
      "anyOf": [
        {
          "$ref": "#/$defs/LoadShape"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "sign_class": {
      "default": "consumer",
      "enum": [
        "consumer",
        "producer",
        "bidirectional"
      ],
      "title": "Sign Class",
      "type": "string"
    },
    "ha_device_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ha Device Id"
    },
    "area_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Area Id"
    },
    "origin": {
      "enum": [
        "user",
        "ha_device",
        "unknown_profile_promotion",
        "migration"
      ],
      "title": "Origin",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "retired_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Retired At"
    }
  },
  "required": [
    "device_id",
    "name",
    "origin",
    "created_at"
  ],
  "title": "PhysicalDevice",
  "type": "object",
  "$id": "https://wattmosaic.local/schemas/physical_device.json",
  "x-contract-version": "4.1.0"
}
