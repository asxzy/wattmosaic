{
  "additionalProperties": false,
  "description": "One immutable, append-only configuration revision of an endpoint.\n\n``valid_until > valid_from`` when set (open-ended revisions use ``None``).\n``declared_by`` records who introduced the revision; DEC-05 requires a\n``\"user\"`` declaration before a CT may have a confirmed SINGLE_SUBJECT\nscope.",
  "properties": {
    "endpoint_id": {
      "title": "Endpoint Id",
      "type": "string"
    },
    "revision": {
      "title": "Revision",
      "type": "integer"
    },
    "valid_from": {
      "format": "date-time",
      "title": "Valid From",
      "type": "string"
    },
    "valid_until": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Valid Until"
    },
    "phase": {
      "enum": [
        "l1",
        "l2",
        "both",
        "unknown"
      ],
      "title": "Phase",
      "type": "string"
    },
    "leg": {
      "anyOf": [
        {
          "enum": [
            "l1",
            "l2"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Leg"
    },
    "voltage_reference_v": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Voltage Reference V"
    },
    "polarity": {
      "enum": [
        "normal",
        "inverted"
      ],
      "title": "Polarity",
      "type": "string"
    },
    "multiplier": {
      "title": "Multiplier",
      "type": "number"
    },
    "calibration_version": {
      "title": "Calibration Version",
      "type": "string"
    },
    "measurement_type": {
      "enum": [
        "instantaneous",
        "window_average",
        "device_reported",
        "calculated",
        "accumulated_energy"
      ],
      "title": "Measurement Type",
      "type": "string"
    },
    "measurement_window_ms": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Measurement Window Ms"
    },
    "expected_interval_s": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expected Interval S"
    },
    "resolution_w": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Resolution W"
    },
    "declared_by": {
      "enum": [
        "user",
        "discovery",
        "migration"
      ],
      "title": "Declared By",
      "type": "string"
    }
  },
  "required": [
    "endpoint_id",
    "revision",
    "valid_from",
    "phase",
    "polarity",
    "multiplier",
    "calibration_version",
    "measurement_type",
    "declared_by"
  ],
  "title": "EndpointConfigRevision",
  "type": "object",
  "$id": "https://wattmosaic.local/schemas/endpoint_config_revision.json",
  "x-contract-version": "2.4.0"
}
