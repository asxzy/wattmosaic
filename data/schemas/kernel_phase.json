{
  "$defs": {
    "LevelStat": {
      "additionalProperties": false,
      "description": "A robust statistic of a level: nullable median/MAD plus a sample count.",
      "properties": {
        "median_w": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Median W"
        },
        "mad_w": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mad W"
        },
        "n": {
          "default": 0,
          "title": "N",
          "type": "integer"
        }
      },
      "title": "LevelStat",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One phase of a response kernel (delay / amplitude / duration).",
  "properties": {
    "phase": {
      "enum": [
        "startup",
        "active",
        "steady",
        "shutdown",
        "standby"
      ],
      "title": "Phase",
      "type": "string"
    },
    "delay_s": {
      "$ref": "#/$defs/LevelStat"
    },
    "amplitude_w": {
      "$ref": "#/$defs/LevelStat"
    },
    "duration_s": {
      "$ref": "#/$defs/LevelStat"
    }
  },
  "required": [
    "phase"
  ],
  "title": "KernelPhase",
  "type": "object",
  "$id": "https://wattmosaic.local/schemas/kernel_phase.json",
  "x-contract-version": "3.0.0"
}
