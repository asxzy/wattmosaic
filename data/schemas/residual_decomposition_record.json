{
  "$defs": {
    "ConfidenceVector": {
      "additionalProperties": false,
      "description": "Independent confidence dimensions.\n\nDeliberately has **no** aggregate field, no ``__float__`` and no arithmetic:\na consumer that wants one number must say which dimension it means.  Merging\nthe six components into one weighted blend is the defect this model exists\nto stop repeating (see ``docs/assessment_gap_analysis.md`` G14).",
      "properties": {
        "power": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Power"
        },
        "ct_association": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ct Association"
        },
        "topology": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Topology"
        },
        "circuit_classification": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Circuit Classification"
        },
        "residual": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Residual"
        },
        "method": {
          "default": "unavailable",
          "title": "Method",
          "type": "string"
        }
      },
      "title": "ConfidenceVector",
      "type": "object"
    },
    "MeasurementBasis": {
      "description": "What produced the watt value, independent of how much we trust it.\n\n``Source`` answers *\"how was the value obtained\"*; this answers *\"what kind\nof instrument produced the watts\"*.  A ``DIRECT_MEASURED`` result can be\n``FACTOR_ADJUSTED``, and a ``MODEL_ESTIMATED`` result can never be\n``CT_MEASURED``.",
      "enum": [
        "ct_measured",
        "monitor_reported",
        "factor_adjusted",
        "estimated_appliance_total",
        "unknown"
      ],
      "title": "MeasurementBasis",
      "type": "string"
    },
    "QualityStatus": {
      "enum": [
        "good",
        "degraded",
        "stale",
        "bad",
        "missing"
      ],
      "title": "QualityStatus",
      "type": "string"
    },
    "ResidualKind": {
      "description": "The sign of a residual, derived from the value and never supplied.",
      "enum": [
        "positive",
        "negative",
        "near_zero"
      ],
      "title": "ResidualKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "The three components of an unexplained power window, plus its event.\n\nThe three components are the residual model's own split (``05-\u2026`` \u00a73): an\nalways-on baseline, a cycling dynamic part and a noise part.  When\n``is_complete`` is ``True`` the three sum to ``total_residual_w``; when it\nis ``False`` the undeterminable components stay ``None`` and are **never**\nback-filled to force the identity.\n\n``decomposition`` and ``decomposition_scope`` carry the **wire form** (a\nplain mapping) rather than the ``models/residual_power.py`` dataclasses.\nThe contract layer must not import from the model layer\n(``docs/architecture.md:78-84``): ``models`` imports ``contracts``, so the\nreverse edge would close an import cycle and break every module that\nimports ``wattmosaic_engine.storage`` first.  The mapping is what the API\nserialises; the source dataclasses are ``ResidualDecomposition``\n(``models/residual_power.py:925``) and ``ResidualScope``\n(``models/residual_power.py:195``).",
  "properties": {
    "record_id": {
      "title": "Record Id",
      "type": "string"
    },
    "window_start": {
      "format": "date-time",
      "title": "Window Start",
      "type": "string"
    },
    "window_end": {
      "format": "date-time",
      "title": "Window End",
      "type": "string"
    },
    "total_residual_w": {
      "title": "Total Residual W",
      "type": "number"
    },
    "baseline_w": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Baseline W"
    },
    "dynamic_w": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Dynamic W"
    },
    "noise_w": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Noise W"
    },
    "is_complete": {
      "default": false,
      "title": "Is Complete",
      "type": "boolean"
    },
    "unknown_event_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Unknown Event Id"
    },
    "decomposition": {
      "additionalProperties": true,
      "title": "Decomposition",
      "type": "object"
    },
    "decomposition_scope": {
      "additionalProperties": true,
      "title": "Decomposition Scope",
      "type": "object"
    },
    "kind": {
      "$ref": "#/$defs/ResidualKind"
    },
    "confidence": {
      "$ref": "#/$defs/ConfidenceVector"
    },
    "basis": {
      "$ref": "#/$defs/MeasurementBasis",
      "default": "unknown"
    },
    "quality": {
      "$ref": "#/$defs/QualityStatus",
      "default": "good"
    },
    "rejected_samples": {
      "default": 0,
      "title": "Rejected Samples",
      "type": "integer"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "record_id",
    "window_start",
    "window_end",
    "total_residual_w",
    "decomposition",
    "decomposition_scope",
    "kind"
  ],
  "title": "ResidualDecompositionRecord",
  "type": "object",
  "$id": "https://wattmosaic.local/schemas/residual_decomposition_record.json",
  "x-contract-version": "2.2.0"
}
