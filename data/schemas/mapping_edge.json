{
  "$defs": {
    "EdgeEvidence": {
      "additionalProperties": false,
      "description": "Immutable-style counters of support/conflict for one edge (design \u00a75).\n\n``parent_only`` events are neutral: they are recorded as residual evidence\nand **never counted against an edge** (HB \u00a74.3, AT-2).  The derived\n:attr:`conflict_ratio` therefore uses only the decisive support/conflict\ncounts and returns ``0.0`` when there is no decisive evidence yet.",
      "properties": {
        "support": {
          "default": 0,
          "title": "Support",
          "type": "integer"
        },
        "conflict": {
          "default": 0,
          "title": "Conflict",
          "type": "integer"
        },
        "parent_only": {
          "default": 0,
          "title": "Parent Only",
          "type": "integer"
        },
        "independent_causes": {
          "default": 0,
          "title": "Independent Causes",
          "type": "integer"
        },
        "last_support_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Support At"
        },
        "last_conflict_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Conflict At"
        }
      },
      "title": "EdgeEvidence",
      "type": "object"
    },
    "EdgeLifecycleV3": {
      "description": "Lifecycle of a single v3 topology or mapping edge (HB \u00a74.3).\n\nThis is a *new* seven-state vocabulary.  The legacy :class:`EdgeLifecycle`\nhas a different member set (it includes ``UNDER_REVIEW`` and omits nothing,\nbut is not identical); it is deliberately left alone.  One event never moves\nan edge past CANDIDATE (DEC-10).",
      "enum": [
        "candidate",
        "provisional",
        "confirmed",
        "conflicted",
        "suspected_change",
        "rejected",
        "retired"
      ],
      "title": "EdgeLifecycleV3",
      "type": "string"
    },
    "Observability": {
      "description": "The seven HB \u00a79.7 observability states (in the handbook's order).",
      "enum": [
        "direct",
        "expected",
        "inferred",
        "partial",
        "unknown",
        "not_observable",
        "conflicted"
      ],
      "title": "Observability",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "A subject\u2194reader mapping edge (\u00a74), with its own lifecycle and version.\n\n``endpoint_id`` is the *most specific* reader; ancestors are derived through\ntopology.  An unknown-profile subject may only be mapped through an\ninferred or partial observation.",
  "properties": {
    "mapping_edge_id": {
      "title": "Mapping Edge Id",
      "type": "string"
    },
    "subject_kind": {
      "enum": [
        "device",
        "component",
        "unknown_profile"
      ],
      "title": "Subject Kind",
      "type": "string"
    },
    "subject_id": {
      "title": "Subject Id",
      "type": "string"
    },
    "endpoint_id": {
      "title": "Endpoint Id",
      "type": "string"
    },
    "observability": {
      "$ref": "#/$defs/Observability"
    },
    "lifecycle": {
      "$ref": "#/$defs/EdgeLifecycleV3"
    },
    "declared_by": {
      "enum": [
        "user",
        "auto_placement",
        "inference",
        "migration"
      ],
      "title": "Declared By",
      "type": "string"
    },
    "evidence": {
      "$ref": "#/$defs/EdgeEvidence"
    },
    "valid_from": {
      "format": "date-time",
      "title": "Valid From",
      "type": "string"
    },
    "valid_until": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Valid Until"
    }
  },
  "required": [
    "mapping_edge_id",
    "subject_kind",
    "subject_id",
    "endpoint_id",
    "observability",
    "lifecycle",
    "declared_by",
    "evidence",
    "valid_from"
  ],
  "title": "MappingEdge",
  "type": "object",
  "$id": "https://wattmosaic.local/schemas/mapping_edge.json",
  "x-contract-version": "3.0.0"
}
