{
  "$defs": {
    "ConfidenceVector": {
      "additionalProperties": false,
      "description": "Independent confidence dimensions.\n\nDeliberately has **no** aggregate field, no ``__float__`` and no arithmetic:\na consumer that wants one number must say which dimension it means.  Merging\nthe six components into one weighted blend is the defect this model exists\nto stop repeating (see ``docs/assessment_gap_analysis.md`` G14).",
      "properties": {
        "power": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Power"
        },
        "ct_association": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ct Association"
        },
        "topology": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Topology"
        },
        "circuit_classification": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Circuit Classification"
        },
        "residual": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Residual"
        },
        "method": {
          "default": "unavailable",
          "title": "Method",
          "type": "string"
        }
      },
      "title": "ConfidenceVector",
      "type": "object"
    },
    "EventIsolation": {
      "additionalProperties": false,
      "description": "Whether one device event's power window can be attributed.\n\nThe *original* ``occurred_at`` is carried unchanged: isolation analysis adds\nan offset and a window, it never rewrites when the event happened.",
      "properties": {
        "status": {
          "$ref": "#/$defs/IsolationStatus"
        },
        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "device_id": {
          "title": "Device Id",
          "type": "string"
        },
        "entity_id": {
          "title": "Entity Id",
          "type": "string"
        },
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
        "received_at": {
          "format": "date-time",
          "title": "Received At",
          "type": "string"
        },
        "analysis_offset_s": {
          "default": 0.0,
          "title": "Analysis Offset S",
          "type": "number"
        },
        "isolation_window_s": {
          "default": 0.0,
          "title": "Isolation Window S",
          "type": "number"
        },
        "window_start": {
          "format": "date-time",
          "title": "Window Start",
          "type": "string"
        },
        "window_end": {
          "format": "date-time",
          "title": "Window End",
          "type": "string"
        },
        "competing_event_ids": {
          "items": {
            "type": "string"
          },
          "title": "Competing Event Ids",
          "type": "array"
        },
        "competing_device_ids": {
          "items": {
            "type": "string"
          },
          "title": "Competing Device Ids",
          "type": "array"
        },
        "power_window_contaminated": {
          "default": false,
          "title": "Power Window Contaminated",
          "type": "boolean"
        },
        "reason": {
          "default": "",
          "title": "Reason",
          "type": "string"
        },
        "evidence": {
          "additionalProperties": true,
          "title": "Evidence",
          "type": "object"
        }
      },
      "required": [
        "status",
        "event_id",
        "device_id",
        "entity_id",
        "occurred_at",
        "received_at",
        "window_start",
        "window_end"
      ],
      "title": "EventIsolation",
      "type": "object"
    },
    "IsolationStatus": {
      "description": "Whether an event's power window is clean enough to attribute power.\n\nA number inside a blended score cannot answer \"was this event isolated?\".\nThis is the durable, named answer.",
      "enum": [
        "isolated",
        "contaminated",
        "insufficient_data"
      ],
      "title": "IsolationStatus",
      "type": "string"
    },
    "QualityStatus": {
      "enum": [
        "good",
        "degraded",
        "stale",
        "bad",
        "missing"
      ],
      "title": "QualityStatus",
      "type": "string"
    },
    "Source": {
      "description": "How device power was obtained (measurement hierarchy, spec \u00a79.1).",
      "enum": [
        "direct_measured",
        "inferred",
        "model_estimated",
        "configured_prior",
        "unknown"
      ],
      "title": "Source",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "An immutable, replay-sufficient record of one observed event.\n\nThe record is **immutable**: a correction is a new record with a new\n``event_id`` and a link in ``related_event_ids``.  No field of a stored\nrecord is ever updated in place.",
  "properties": {
    "event_id": {
      "title": "Event Id",
      "type": "string"
    },
    "entity_id": {
      "title": "Entity Id",
      "type": "string"
    },
    "device_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Device Id"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "recorded_at": {
      "format": "date-time",
      "title": "Recorded At",
      "type": "string"
    },
    "new_state": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "New State"
    },
    "old_state": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Old State"
    },
    "payload_hash": {
      "default": "",
      "title": "Payload Hash",
      "type": "string"
    },
    "payload": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Payload"
    },
    "attributes": {
      "anyOf": [
        {
          "additionalProperties": {
            "type": "number"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Attributes"
    },
    "power_w": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Power W"
    },
    "quality": {
      "$ref": "#/$defs/QualityStatus",
      "default": "good"
    },
    "source": {
      "$ref": "#/$defs/Source",
      "default": "unknown"
    },
    "isolation": {
      "$ref": "#/$defs/EventIsolation"
    },
    "confidence": {
      "$ref": "#/$defs/ConfidenceVector"
    },
    "related_event_ids": {
      "items": {
        "type": "string"
      },
      "title": "Related Event Ids",
      "type": "array"
    },
    "replay_sufficient": {
      "default": false,
      "title": "Replay Sufficient",
      "type": "boolean"
    },
    "version": {
      "default": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "event_id",
    "entity_id",
    "observed_at",
    "isolation"
  ],
  "title": "EventEvidenceRecord",
  "type": "object",
  "$id": "https://wattmosaic.local/schemas/event_evidence_record.json",
  "x-contract-version": "3.0.0"
}
