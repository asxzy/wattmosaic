    },
    "phase": {
      "$ref": "#/$defs/Phase",
      "default": "unknown"
    },
    "parent_ct_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Ct Id"
    },
    "polarity": {
      "$ref": "#/$defs/Polarity",
      "default": "normal"
    },
    "device_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Device Id"
    },
    "enabled": {
      "default": true,
      "title": "Enabled",
      "type": "boolean"
    },
    "paired_ct_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Paired Ct Id"
    },
    "alias_of_ct_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Alias Of Ct Id"
    },
    "measurement_multiplier": {
      "default": 1.0,
      "title": "Measurement Multiplier",
      "type": "number"
    },
    "nominal_voltage": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Nominal Voltage"
    },
    "resolution_w": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Resolution W"
    },
    "expected_interval_s": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
