      "default": null,
      "title": "Expected Interval S"
    },
    "reliability": {
      "default": 1.0,
      "title": "Reliability",
      "type": "number"
    },
    "topology_status": {
      "$ref": "#/$defs/TopologyStatus",
      "default": "candidate"
