{
  "$defs": {
    "CTType": {
      "enum": [
        "main",
        "branch",
        "dedicated_device",
        "unknown"
      ],
      "title": "CTType",
      "type": "string"
    },
    "Phase": {
      "enum": [
        "l1",
        "l2",
        "both",
        "unknown"
      ],
      "title": "Phase",
      "type": "string"
    },
    "Polarity": {
      "enum": [
        "normal",
        "inverted"
      ],
      "title": "Polarity",
      "type": "string"
    },
    "TopologyStatus": {
      "enum": [
        "candidate",
        "confirmed",
        "rejected"
      ],
      "title": "TopologyStatus",
      "type": "string"
