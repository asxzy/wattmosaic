{
  "$defs": {
    "MappingStatus": {
      "description": "The epistemic state of one device\u2194reader mapping (HB \u00a79.7).\n\nDeliberately contains **no** identifiability value (``analysis/E-\u2026`` C1):\nidentifiability is a separate axis, carried by ``MappingCell.identifiability``\nas an :class:`~wattmosaic_engine.contracts.foundation.IdentifiabilityStatus`.",
      "enum": [
        "unknown",
        "learning",
        "provisional",
        "confirmed",
        "suspected_change",
        "conflicted",
        "retired"
      ],
      "title": "MappingStatus",
      "type": "string"
    },
    "Observability": {
      "description": "The seven HB \u00a79.7 observability states (in the handbook's order).",
      "enum": [
        "direct",
        "expected",
        "inferred",
        "partial",
        "unknown",
        "not_observable",
        "conflicted"
      ],
      "title": "Observability",
      "type": "string"
    },
    "RelationType": {
      "description": "The five reader\u2194reader relation kinds of HB \u00a74.2 (DEC-10, DEC-11).",
      "enum": [
        "contains",
        "shared_load",
        "paired_leg",
        "correlated",
        "same_conductor"
      ],
      "title": "RelationType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "The mapping block of a cell: how the reader observes the load.",
  "properties": {
    "observability": {
      "$ref": "#/$defs/Observability"
    },
    "relation_type": {
      "anyOf": [
        {
          "$ref": "#/$defs/RelationType"
        },
        {
          "const": "direct_endpoint",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Relation Type"
    },
    "mapping_status": {
      "$ref": "#/$defs/MappingStatus"
    },
    "mapping_confidence": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Mapping Confidence"
    },
    "valid_from": {
      "format": "date-time",
      "title": "Valid From",
      "type": "string"
    },
    "valid_until": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Valid Until"
    }
  },
  "required": [
    "observability",
    "relation_type",
    "mapping_status",
    "valid_from"
  ],
  "title": "CellMapping",
  "type": "object",
  "$id": "https://wattmosaic.local/schemas/cell_mapping.json",
  "x-contract-version": "2.4.0"
}
