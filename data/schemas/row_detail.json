{
  "$defs": {
    "Bounds": {
      "additionalProperties": false,
      "description": "A justified interval for an estimate.\n\n``lower_w`` and ``upper_w`` are nullable (HB \u00a718).  When both are present\nthe validator requires ``lower_w <= upper_w``.  A zero-width interval\n(a point) is only possible through the private :meth:`_point` constructor,\nwhich represents an IDENTIFIABLE or MEASURED result; the ``allow_point``\nflag is *not* a field and never appears in the model or its JSON schema.",
      "properties": {
        "lower_w": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lower W"
        },
        "upper_w": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Upper W"
        },
        "basis": {
          "anyOf": [
            {
              "enum": [
                "non_negativity",
                "group_sum",
                "reader_ceiling",
                "posterior",
                "declared_ceiling"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Basis"
        }
      },
      "title": "Bounds",
      "type": "object"
    },
    "CellEvents": {
      "additionalProperties": false,
      "description": "Independent event-association counts (HB \u00a710.3: 100 samples \u2260 100 events).",
      "properties": {
        "matched_event_count": {
          "default": 0,
          "title": "Matched Event Count",
          "type": "integer"
        },
        "confirmed_match_count": {
          "default": 0,
          "title": "Confirmed Match Count",
          "type": "integer"
        },
        "provisional_match_count": {
          "default": 0,
          "title": "Provisional Match Count",
          "type": "integer"
        },
        "avg_response_delay_ms": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Avg Response Delay Ms"
        },
        "response_signature": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Response Signature"
        },
        "last_matched_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Matched At"
        }
      },
      "title": "CellEvents",
      "type": "object"
    },
    "CellMapping": {
      "additionalProperties": false,
      "description": "The mapping block of a cell: how the reader observes the load.",
      "properties": {
        "observability": {
          "$ref": "#/$defs/Observability"
        },
        "relation_type": {
          "anyOf": [
            {
              "$ref": "#/$defs/RelationType"
            },
            {
              "const": "direct_endpoint",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Relation Type"
        },
        "mapping_status": {
          "$ref": "#/$defs/MappingStatus"
        },
        "mapping_confidence": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mapping Confidence"
        },
        "valid_from": {
          "format": "date-time",
          "title": "Valid From",
          "type": "string"
        },
        "valid_until": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid Until"
        }
      },
      "required": [
        "observability",
        "relation_type",
        "mapping_status",
        "valid_from"
      ],
      "title": "CellMapping",
      "type": "object"
    },
    "CellPower": {
      "additionalProperties": false,
      "description": "The power block of a cell: contribution, bounds and operating state.\n\n``estimated_power_w`` is ``None`` when the mapping is not observable or the\ncell is group-only; it is never defaulted to ``0`` (HB \u00a718).",
      "properties": {
        "measurement_status": {
          "$ref": "#/$defs/EstimateStatus"
        },
        "estimated_power_w": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimated Power W"
        },
        "bounds": {
          "anyOf": [
            {
              "$ref": "#/$defs/Bounds"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "standby_power_w": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Standby Power W"
        },
        "operating_state": {
          "anyOf": [
            {
              "$ref": "#/$defs/PowerLevelV3"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "expected_profile_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Profile Ref"
        },
        "uncertainty_w": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uncertainty W"
        }
      },
      "required": [
        "measurement_status"
      ],
      "title": "CellPower",
      "type": "object"
    },
    "CellProvenance": {
      "additionalProperties": false,
      "description": "Typed, resolvable provenance for a cell (HB \u00a79.6 / \u00a718).",
      "properties": {
        "sources_used": {
          "items": {
            "type": "string"
          },
          "title": "Sources Used",
          "type": "array"
        },
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "topology_version_id": {
          "title": "Topology Version Id",
          "type": "string"
        },
        "model_version_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Version Id"
        },
        "mapping_version_id": {
          "title": "Mapping Version Id",
          "type": "string"
        }
      },
      "required": [
        "topology_version_id",
        "mapping_version_id"
      ],
      "title": "CellProvenance",
      "type": "object"
    },
    "CellTimestamps": {
      "additionalProperties": false,
      "description": "The observation/validation/refresh times of a cell.",
      "properties": {
        "first_observed_at": {
          "format": "date-time",
          "title": "First Observed At",
          "type": "string"
        },
        "last_observed_at": {
          "format": "date-time",
          "title": "Last Observed At",
          "type": "string"
        },
        "last_validated_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Validated At"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "first_observed_at",
        "last_observed_at",
        "updated_at"
      ],
      "title": "CellTimestamps",
      "type": "object"
    },
    "CellVisual": {
      "description": "The eight deterministic visual categories (HB \u00a719.3 / design \u00a78).",
      "enum": [
        "directly_measured",
        "confirmed_inferred",
        "provisional",
        "group_only",
        "unknown",
        "not_observable",
        "conflicted",
        "retired"
      ],
      "title": "CellVisual",
      "type": "string"
    },
    "ConfidenceVectorV3": {
      "additionalProperties": false,
      "description": "Seven-component confidence vector for a v3 estimate.\n\nEach component is an *uncalibrated engineering score* in ``[0, 1]`` or\n``None`` when not assessed.  **This is not a probability** (ADR-0007): the\nnumbers are not calibrated, do not sum to one, and must not be interpreted\nas likelihoods.  There is deliberately **no blended scalar** field, no\n``__float__`` and no arithmetic -- a consumer must name the component it\nmeans (DEC-24; HB \u00a79.6).",
      "properties": {
        "measurement_quality": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Measurement Quality"
        },
        "event_association": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Event Association"
        },
        "model_fit": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Fit"
        },
        "topology_consistency": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Topology Consistency"
        },
        "identifiability": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Identifiability"
        },
        "sample_coverage": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sample Coverage"
        },
        "freshness": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Freshness"
        }
      },
      "title": "ConfidenceVectorV3",
      "type": "object"
    },
    "EstimateStatus": {
      "description": "What kind of value an estimate is (HB \u00a78.5).",
      "enum": [
        "measured",
        "estimated",
        "allocated",
        "unknown"
      ],
      "title": "EstimateStatus",
      "type": "string"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "description": "A typed, resolvable reference to a piece of evidence (D4's resolver).",
      "properties": {
        "kind": {
          "enum": [
            "sample",
            "event_evidence",
            "event_group",
            "ha_event",
            "edge",
            "mapping_edge",
            "model_version",
            "configuration_event",
            "observation"
          ],
          "title": "Kind",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "IdentifiabilityStatus": {
      "description": "Identifiability of an estimate (HB \u00a78.4).",
      "enum": [
        "identifiable",
        "partially_identifiable",
        "group_identifiable",
        "non_identifiable",
        "insufficient_evidence"
      ],
      "title": "IdentifiabilityStatus",
      "type": "string"
    },
    "MappingCell": {
      "additionalProperties": false,
      "description": "One device/component \u00d7 reader cell of the matrix (HB \u00a79.6).",
      "properties": {
        "row_kind": {
          "$ref": "#/$defs/RowKind"
        },
        "row_id": {
          "title": "Row Id",
          "type": "string"
        },
        "load_component_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Load Component Id"
        },
        "reader_id": {
          "title": "Reader Id",
          "type": "string"
        },
        "mapping": {
          "$ref": "#/$defs/CellMapping"
        },
        "power": {
          "$ref": "#/$defs/CellPower"
        },
        "identifiability": {
          "$ref": "#/$defs/IdentifiabilityStatus"
        },
        "group_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Group Id"
        },
        "event_association": {
          "$ref": "#/$defs/CellEvents"
        },
        "confidence": {
          "$ref": "#/$defs/ConfidenceVectorV3"
        },
        "provenance": {
          "$ref": "#/$defs/CellProvenance"
        },
        "timestamps": {
          "$ref": "#/$defs/CellTimestamps"
        },
        "visual": {
          "$ref": "#/$defs/CellVisual"
        },
        "derived": {
          "default": false,
          "title": "Derived",
          "type": "boolean"
        }
      },
      "required": [
        "row_kind",
        "row_id",
        "reader_id",
        "mapping",
        "power",
        "identifiability",
        "event_association",
        "confidence",
        "provenance",
        "timestamps",
        "visual"
      ],
      "title": "MappingCell",
      "type": "object"
    },
    "MappingStatus": {
      "description": "The epistemic state of one device\u2194reader mapping (HB \u00a79.7).\n\nDeliberately contains **no** identifiability value (``analysis/E-\u2026`` C1):\nidentifiability is a separate axis, carried by ``MappingCell.identifiability``\nas an :class:`~wattmosaic_engine.contracts.foundation.IdentifiabilityStatus`.",
      "enum": [
        "unknown",
        "learning",
        "provisional",
        "confirmed",
        "suspected_change",
        "conflicted",
        "retired"
      ],
      "title": "MappingStatus",
      "type": "string"
    },
    "Observability": {
      "description": "The seven HB \u00a79.7 observability states (in the handbook's order).",
      "enum": [
        "direct",
        "expected",
        "inferred",
        "partial",
        "unknown",
        "not_observable",
        "conflicted"
      ],
      "title": "Observability",
      "type": "string"
    },
    "PowerLevelV3": {
      "description": "Operating level of a published value (HB \u00a711.5).\n\n``OFF`` and ``STANDBY`` are distinct members: OFF is a transition endpoint, not a claim of 0 W (HB \u00a711.5,\nrule 6).  ``UNKNOWN`` is the neutral default.",
      "enum": [
        "off",
        "standby",
        "idle",
        "active",
        "transient",
        "unknown"
      ],
      "title": "PowerLevelV3",
      "type": "string"
    },
    "RelationType": {
      "description": "The five reader\u2194reader relation kinds of HB \u00a74.2 (DEC-10, DEC-11).",
      "enum": [
        "contains",
        "shared_load",
        "paired_leg",
        "correlated",
        "same_conductor"
      ],
      "title": "RelationType",
      "type": "string"
    },
    "RowKind": {
      "description": "The row families of the matrix (DEC-27).",
      "enum": [
        "device",
        "component",
        "group",
        "unknown_profile",
        "reader_residual",
        "summary"
      ],
      "title": "RowKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Row (device) drill-down: operating state, profile and mapping history.",
  "properties": {
    "row_id": {
      "title": "Row Id",
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/RowKind"
    },
    "label": {
      "title": "Label",
      "type": "string"
    },
    "operating_state": {
      "anyOf": [
        {
          "$ref": "#/$defs/PowerLevelV3"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "power_profile_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Power Profile Ref"
    },
    "observed_readers": {
      "items": {
        "type": "string"
      },
      "title": "Observed Readers",
      "type": "array"
    },
    "mapping_history": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Mapping History",
      "type": "array"
    },
    "cells": {
      "items": {
        "$ref": "#/$defs/MappingCell"
      },
      "title": "Cells",
      "type": "array"
    }
  },
  "required": [
    "row_id",
    "kind",
    "label"
  ],
  "title": "RowDetail",
  "type": "object",
  "$id": "https://wattmosaic.local/schemas/row_detail.json",
  "x-contract-version": "4.0.0"
}
