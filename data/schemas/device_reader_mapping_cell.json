{
  "$defs": {
    "ConfidenceVector": {
      "additionalProperties": false,
      "description": "Independent confidence dimensions.\n\nDeliberately has **no** aggregate field, no ``__float__`` and no arithmetic:\na consumer that wants one number must say which dimension it means.  Merging\nthe six components into one weighted blend is the defect this model exists\nto stop repeating (see ``docs/assessment_gap_analysis.md`` G14).",
      "properties": {
        "power": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Power"
        },
        "ct_association": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ct Association"
        },
        "topology": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Topology"
        },
        "circuit_classification": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Circuit Classification"
        },
        "residual": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Residual"
        },
        "method": {
          "default": "unavailable",
          "title": "Method",
          "type": "string"
        }
      },
      "title": "ConfidenceVector",
      "type": "object"
    },
    "MappingCellStatus": {
      "description": "The freshness of one device/reader mapping cell (spec 09 \u00a77.5).",
      "enum": [
        "valid",
        "stale",
        "invalid",
        "unknown"
      ],
      "title": "MappingCellStatus",
      "type": "string"
    },
    "MappingObservability": {
      "description": "How directly a reader observes a device (spec 09 \u00a77.5).",
      "enum": [
        "direct",
        "derived",
        "indirect",
        "unknown"
      ],
      "title": "MappingObservability",
      "type": "string"
    },
    "MeasurementBasis": {
      "description": "What produced the watt value, independent of how much we trust it.\n\n``Source`` answers *\"how was the value obtained\"*; this answers *\"what kind\nof instrument produced the watts\"*.  A ``DIRECT_MEASURED`` result can be\n``FACTOR_ADJUSTED``, and a ``MODEL_ESTIMATED`` result can never be\n``CT_MEASURED``.",
      "enum": [
        "ct_measured",
        "monitor_reported",
        "factor_adjusted",
        "estimated_appliance_total",
        "unknown"
      ],
      "title": "MeasurementBasis",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "One cell of the device/reader mapping matrix.\n\nHow much a reader contributes to a device, with the bounds and the\nobservability that make the number honest.",
  "properties": {
    "device_id": {
      "title": "Device Id",
      "type": "string"
    },
    "reader_id": {
      "title": "Reader Id",
      "type": "string"
    },
    "reader_configuration_version": {
      "title": "Reader Configuration Version",
      "type": "string"
    },
    "observability": {
      "$ref": "#/$defs/MappingObservability",
      "default": "unknown"
    },
    "estimated_contribution_w": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Estimated Contribution W"
    },
    "min_contribution_w": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Min Contribution W"
    },
    "max_contribution_w": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Max Contribution W"
    },
    "confidence": {
      "$ref": "#/$defs/ConfidenceVector"
    },
    "evidence_count": {
      "default": 0,
      "title": "Evidence Count",
      "type": "integer"
    },
    "last_validated_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Validated At"
    },
    "version": {
      "default": 1,
      "title": "Version",
      "type": "integer"
    },
    "status": {
      "$ref": "#/$defs/MappingCellStatus",
      "default": "unknown"
    },
    "basis": {
      "$ref": "#/$defs/MeasurementBasis",
      "default": "unknown"
    }
  },
  "required": [
    "device_id",
    "reader_id",
    "reader_configuration_version"
  ],
  "title": "DeviceReaderMappingCell",
  "type": "object",
  "$id": "https://wattmosaic.local/schemas/device_reader_mapping_cell.json",
  "x-contract-version": "2.1.0"
}
